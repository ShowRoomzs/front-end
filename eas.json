{
  "cli": {
    "version": ">= 16.28.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_NAVER_CLIENT_ID": "@EXPO_PUBLIC_NAVER_CLIENT_ID",
        "EXPO_PUBLIC_NAVER_SECRET_KEY": "@EXPO_PUBLIC_NAVER_SECRET_KEY",
        "EXPO_PUBLIC_KAKAO_NATIVE_APP_KEY": "@EXPO_PUBLIC_KAKAO_NATIVE_APP_KEY",
        "EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID": "@EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID",
        "EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID": "@EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID",
        "EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID": "@EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID",
        "EXPO_PUBLIC_API_HOST": "@EXPO_PUBLIC_API_HOST"
      }
    },
    "preview": {
      "distribution": "internal"
    },
    "production": {
      "autoIncrement": true
    }
  },
  "submit": {
    "production": {}
  }
}
